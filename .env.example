# Stellar Testnet Wallet — environment configuration
#
# Copy this file to `.env` only if you need to override a default.
# The app is Testnet-only out of the box; all values below are the SDF
# Testnet defaults, so no `.env` file is required for normal use.

# Horizon HTTP endpoint for account/transaction queries (Testnet).
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Network name as Freighter reports it ("TESTNET", "PUBLIC", "FUTURENET"...).
VITE_NETWORK_NAME=TESTNET

# Network passphrase, hashed into every transaction signature. Must match
# the network your Freighter wallet is connected to.
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendbot faucet used to fund new testnet accounts.
VITE_FRIENDBOT_URL=https://friendbot.stellar.org
